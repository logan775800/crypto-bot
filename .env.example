# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会上传）
BOT_TOKEN=your-telegram-bot-token
AI_API_KEY=your-ai-api-key
AI_BASE_URL=https://your-ai-relay/v1
AI_MODEL=gpt-4o-mini
ADMIN_CHAT_ID=your-telegram-chat-id

# 部署审批（点 Telegram 按钮触发 Jenkins 部署）
JENKINS_URL=https://your-jenkins-host
JENKINS_JOB=update-crypto-bot
JENKINS_DEPLOY_TOKEN=your-jenkins-remote-build-token
# 推荐：用 Jenkins 用户 API Token 触发（更可靠）
JENKINS_USER=your-jenkins-username
JENKINS_API_TOKEN=your-jenkins-api-token
# 巨鲸地址追踪（免费申请：https://etherscan.io/apis）
ETHERSCAN_API_KEY=your-etherscan-api-key

# Bybit 实盘网格（永续合约）。⚠️ 先在模拟盘验证！
# ⚠️ Bybit 有**两套模拟盘**，key 互不通用，端点也不同：
#   testnet.bybit.com（要单独注册）      → BYBIT_TESTNET=true
#   主站右上角切「模拟交易 Demo Trading」 → BYBIT_TESTNET=demo
#   实盘                                  → BYBIT_TESTNET=false
# 选错端点交易所只回一句 401 API key is invalid，看不出是端点的问题
# 权限只需勾选「合约交易(Contract-Orders/Positions)」，切勿开提现权限
BYBIT_API_KEY=your-bybit-api-key
BYBIT_API_SECRET=your-bybit-api-secret
# true=模拟盘(默认,安全)；改成 false 才走实盘真钱
BYBIT_TESTNET=true

# 实盘下单硬开关。off = 彻底禁止实盘开仓，/killswitch 也打不开。
# 只想用虚拟盘（/vopen）的话设成 off，账户查询和平仓不受影响。
LIVE_TRADING=off

# 币安交易（合约 + 现货）。⚠️ 默认测试网，改 false 才是实盘。
# 合约测试网 key：https://testnet.binancefuture.com （要单独注册，和实盘不通用）
# 实盘 key：币安后台建，**必须勾「启用期货」**，别勾提现；建议绑服务器 IP
BINANCE_API_KEY=your-binance-api-key
BINANCE_API_SECRET=your-binance-api-secret
BINANCE_TESTNET=true
